# Copy this file to ".env" and fill in the values:   cp .env.example .env
# ".env" is listed in .gitignore and .dockerignore: it must NEVER be pushed to GitHub.
# Use letters and digits only in passwords (symbols break the database URL).

DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=1.0

SECRET_KEY=paste-a-long-random-string-here
MYSQL_ROOT_PASSWORD=ChangeThisRootPass123
MYSQL_PASSWORD=ChangeThisAppPass123
MYSQL_DATABASE=parallelvision
MYSQL_USER=appuser

S3_BUCKET=your-s3-bucket-name
AWS_REGION=eu-north-1

# host port for the website (80 on a fresh server; use 8000 if port 80 is already taken)
WEB_PORT=80
# host port for the database (127.0.0.1 only); change if 3306 is already taken
DB_HOST_PORT=3306
